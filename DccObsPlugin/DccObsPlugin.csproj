<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <RootNamespace>DccObsPlugin</RootNamespace>
    <AssemblyName>DccObsPlugin</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <!-- OBS 27 及更早的 CLRHost 托管互操作(32位);OBS 28+ 应改用 obs-websocket,此处保持兼容 -->
    <Reference Include="CLRHost.Interop">
      <HintPath>..\packages\OBS\CLRHost.Interop.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CameraControl.Core\CameraControl.Core.csproj" />
  </ItemGroup>

</Project>
