<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <RootNamespace>CameraControl.Devices</RootNamespace>
    <AssemblyName>CameraControl.Devices</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultItems>true</EnableDefaultItems>
    <!-- WIA COM interop 仍是 WIA 相机回退路径;Windows 兼容模式提供 System.Drawing 等 -->
    <UseWindowsForms>false</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Interop.WIA">
      <HintPath>..\refs\Interop.WIA.dll</HintPath>
      <EmbedInteropTypes>true</EmbedInteropTypes>
    </Reference>
    <!-- Accord 3.8.2-alpha 的 Frame 属性绑定 CoreCompat.System.Drawing;shim 转发到 System.Drawing.Common -->
    <Reference Include="CoreCompat.System.Drawing">
      <HintPath>..\refs\CoreCompat.System.Drawing\bin\Release\netstandard2.0\CoreCompat.System.Drawing.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Canon.Eos.Framework\Canon.Eos.Framework.csproj" />
    <ProjectReference Include="..\PortableDeviceLib\PortableDeviceLib.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Accord" Version="3.8.2-alpha" />
    <PackageReference Include="Accord.Video" Version="3.8.2-alpha" />
    <PackageReference Include="Accord.Video.DirectShow" Version="3.8.2-alpha" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Rssdp" Version="2.0.9" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.12" />
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="WebSocketSharp" Version="1.0.3-rc11" />
    <!-- net8-windows10.0.22621 目标框架原生内置 WinRT(API),替代 Microsoft.Windows.SDK.Contracts -->
  </ItemGroup>

</Project>
