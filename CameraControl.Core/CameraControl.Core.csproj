<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <RootNamespace>CameraControl.Core</RootNamespace>
    <AssemblyName>CameraControl.Core</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Interop.WIA">
      <HintPath>..\refs\Interop.WIA.dll</HintPath>
      <EmbedInteropTypes>true</EmbedInteropTypes>
    </Reference>
    <Reference Include="Interop.PortableDeviceApiLib">
      <HintPath>..\refs\Interop.PortableDeviceApiLib.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
    </Reference>
    <Reference Include="Interop.PortableDeviceTypesLib">
      <HintPath>..\refs\Interop.PortableDeviceTypesLib.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
    </Reference>
    <Reference Include="CameraControl.Private">
      <HintPath>..\refs\CameraControl.Private.dll</HintPath>
    </Reference>
    <Reference Include="Gif.Components">
      <HintPath>..\refs\Gif.Components.dll</HintPath>
    </Reference>
    <!-- AForge.Imaging.Formats:仅文件格式解码;旧 net35 程序集,先指向 refs -->
    <Reference Include="AForge.Imaging.Formats">
      <HintPath>..\refs\AForge.Imaging.Formats.dll</HintPath>
    </Reference>
    <Reference Include="AForge.Imaging">
      <HintPath>..\refs\AForge.Imaging.dll</HintPath>
    </Reference>
    <Reference Include="AForge">
      <HintPath>..\refs\AForge.dll</HintPath>
    </Reference>
    <Reference Include="AForge.Math">
      <HintPath>..\refs\AForge.Math.dll</HintPath>
    </Reference>
    <!-- CoreCompat shim:Accord 类型转发(与设备库同一份) -->
    <Reference Include="CoreCompat.System.Drawing">
      <HintPath>..\refs\CoreCompat.System.Drawing\bin\Release\netstandard2.0\CoreCompat.System.Drawing.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CameraControl.Devices\CameraControl.Devices.csproj" />
    <ProjectReference Include="..\PortableDeviceLib\PortableDeviceLib.csproj" />
    <ProjectReference Include="..\Canon.Eos.Framework\Canon.Eos.Framework.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.0.90" />
    <PackageReference Include="ControlzEx" Version="5.0.1" />
    <PackageReference Include="DotNetZip" Version="1.16.0" />
    <PackageReference Include="gong-wpf-dragdrop" Version="4.0.0" />
    <PackageReference Include="log4net" Version="2.0.15" />
    <PackageReference Include="Magick.NET-Q8-AnyCPU" Version="15.0.0" />
    <PackageReference Include="MahApps.Metro" Version="2.4.10" />
    <PackageReference Include="MaterialDesignColors" Version="2.1.4" />
    <PackageReference Include="MaterialDesignThemes" Version="4.9.0" />
    <PackageReference Include="MeasurementProtocolClient" Version="1.0.0" />
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.161" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="sqlite-net-pcl" Version="1.9.172" />
    <PackageReference Include="SQLitePCLRaw.bundle_green" Version="2.1.8" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="8.0.0" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.12" />
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="WriteableBitmapEx" Version="1.6.8" />
    <!-- 以下旧包按需评估:Griffin.WebServer(WebServerOld 用,计划删除该路径)、Eagle(Tcl 脚本) -->
    <PackageReference Include="griffin.framework" Version="1.0.42" />
    <PackageReference Include="Griffin.Networking" Version="0.5.7" />
    <PackageReference Include="Griffin.Networking.Protocol.Http" Version="0.5.2" />
    <PackageReference Include="Griffin.WebServer" Version="0.5.3" />
    <PackageReference Include="Eagle" Version="1.0.8734.30319" />
  </ItemGroup>

</Project>
