<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <RootNamespace>CameraControl</RootNamespace>
    <AssemblyName>CameraControl</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <NoWarn>$(NoWarn);CS7011</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ApplicationDefinition Include="App.xaml" Generator="XamlGenerator" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Interop.VHMediaCOMLib">
      <HintPath>..\packages\XSplit\Interop.VHMediaCOMLib.dll</HintPath>
      <EmbedInteropTypes>true</EmbedInteropTypes>
    </Reference>
    <Reference Include="Interop.WIA">
      <HintPath>..\refs\Interop.WIA.dll</HintPath>
      <EmbedInteropTypes>true</EmbedInteropTypes>
    </Reference>
    <Reference Include="De.TorstenMandelkow.MetroChart">
      <HintPath>..\packages\De.TorstenMandelkow.MetroChart.dll</HintPath>
    </Reference>
    <Reference Include="Gif.Components">
      <HintPath>..\refs\Gif.Components.dll</HintPath>
    </Reference>
    <Reference Include="Gma.QrCodeNet.Encoding">
      <HintPath>..\refs\Gma.QrCodeNet.Encoding.dll</HintPath>
    </Reference>
    <Reference Include="WebEye.StreamPlayerControl">
      <HintPath>..\packages\WebEye.StreamPlayerControl.dll</HintPath>
    </Reference>
    <Reference Include="CoreCompat.System.Drawing">
      <HintPath>..\refs\CoreCompat.System.Drawing\bin\Release\netstandard2.0\CoreCompat.System.Drawing.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CameraControl.Core\CameraControl.Core.csproj" />
    <ProjectReference Include="..\CameraControl.Devices\CameraControl.Devices.csproj" />
    <ProjectReference Include="..\CameraControl.PluginManager\CameraControl.PluginManager.csproj" />
    <ProjectReference Include="..\ZoomAndPan\ZoomAndPan.csproj" />
    <ProjectReference Include="..\CameraControlRemoteCmd\CameraControlRemoteCmd.csproj" />
  </ItemGroup>

